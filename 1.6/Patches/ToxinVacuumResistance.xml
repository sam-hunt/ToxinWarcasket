<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!--
    Optional, off by default: the toxin vacuum setting gives the set the vacuum resistance of
    VFEP's spacer (10th generation) sets, a step above its own tier, as HazardVacuumResistance.xml
    does for the Hazard; the two are independent, so the player can lift either, both or
    neither. The spacer tier setting (SpacerTier.xml) carries the stat as part of the tier, so the
    gate is ToxinWarcasketSettings.ToxinVacuumActive, the toggle or the tier, and this file is
    the one place the Toxin takes the stat from: a second copy under the tier would leave the
    pieces with two VacuumResistance entries once both were on. PatchOperationSetting skips the
    whole patch while neither is on, and the inner PatchOperationModActive while Odyssey, which
    owns the stat, is inactive.

    Values per piece, the spacer sets' and the hazard patch's exactly:
    - VFEP alone: armor 0.2, shoulders 0.1, helmet 0.7, a 1.0 set.
    - Vanilla Gravship Expanded (chapter 1): its ArmorVacuumResistancePatch.xml lowers the
      spacer armors to 0.22 and helmets to 0.65 by defName, shoulders left at 0.1, so no suit
      reaches 1.0 without an oxygen source; the Toxin takes those, matched by package id.
    VGE's patch never names our defs, so the two do not depend on load order. Any
    VacuumResistance already on the pieces (a mod loaded before this one) is removed first, so
    the values below replace it rather than duplicate the stat.

    Save Our Ship 2 runs on its own decompression and hypoxia stats, not VacuumResistance;
    SOS2Patch.xml gives the armor and helmet the EVA tag and this file touches neither.
  -->
  <Operation Class="ToxinWarcasket.PatchOperationSetting">
    <setting>ToxinVacuumActive</setting>
    <match Class="ToxinWarcasket.PatchOperationModActive">
      <packageIds>
        <li>ludeon.rimworld.odyssey</li>
      </packageIds>
      <match Class="PatchOperationSequence">
        <operations>
          <li Class="PatchOperationRemove">
            <success>Always</success>
            <xpath>/Defs/VFEPirates.WarcasketDef[defName = "TXWC_Warcasket_Toxin" or defName = "TXWC_WarcasketShoulders_Toxin" or defName = "TXWC_WarcasketHelmet_Toxin"]/equippedStatOffsets/VacuumResistance</xpath>
          </li>
          <li Class="PatchOperationAdd">
            <xpath>/Defs/VFEPirates.WarcasketDef[defName = "TXWC_WarcasketShoulders_Toxin"]/equippedStatOffsets</xpath>
            <value>
              <VacuumResistance>0.1</VacuumResistance>
            </value>
          </li>
          <li Class="ToxinWarcasket.PatchOperationModActive">
            <packageIds>
              <li>vanillaexpanded.gravship</li>
            </packageIds>
            <match Class="PatchOperationSequence">
              <operations>
                <li Class="PatchOperationAdd">
                  <xpath>/Defs/VFEPirates.WarcasketDef[defName = "TXWC_Warcasket_Toxin"]/equippedStatOffsets</xpath>
                  <value>
                    <VacuumResistance>0.22</VacuumResistance>
                  </value>
                </li>
                <li Class="PatchOperationAdd">
                  <xpath>/Defs/VFEPirates.WarcasketDef[defName = "TXWC_WarcasketHelmet_Toxin"]/equippedStatOffsets</xpath>
                  <value>
                    <VacuumResistance>0.65</VacuumResistance>
                  </value>
                </li>
              </operations>
            </match>
            <nomatch Class="PatchOperationSequence">
              <operations>
                <li Class="PatchOperationAdd">
                  <xpath>/Defs/VFEPirates.WarcasketDef[defName = "TXWC_Warcasket_Toxin"]/equippedStatOffsets</xpath>
                  <value>
                    <VacuumResistance>0.2</VacuumResistance>
                  </value>
                </li>
                <li Class="PatchOperationAdd">
                  <xpath>/Defs/VFEPirates.WarcasketDef[defName = "TXWC_WarcasketHelmet_Toxin"]/equippedStatOffsets</xpath>
                  <value>
                    <VacuumResistance>0.7</VacuumResistance>
                  </value>
                </li>
              </operations>
            </nomatch>
          </li>
        </operations>
      </match>
    </match>
  </Operation>
</Patch>
