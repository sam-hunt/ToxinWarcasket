<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Put on the pilot by TXWC_AbsorbGas (the ability's casterHediff); it carries the absorb, so
    the pull ticks and saves with the pawn. HediffComp_AbsorbGas: a pulse every 30 ticks for the
    hediff's 300, ten in all, each taking up to 64 of every gas type's density from the 25 cells
    within 2.9. Four pulses clear a full cell; the other six catch gas diffusing back in. A
    saturated disc banks 25 charges, a quarter tank.
  -->
  <HediffDef>
    <defName>TXWC_AbsorbingGas</defName>
    <label>absorbing gas</label>
    <description>The warcasket's respirator is drawing in the surrounding air, filtering out every gas and banking it in the reagent tank.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="ToxinWarcasket.HediffCompProperties_AbsorbGas">
        <pulseInterval>30</pulseInterval>
        <radius>2.9</radius>
        <unitsPerPulse>64</unitsPerPulse>
        <unitsPerCharge>255</unitsPerCharge>
      </li>
    </comps>
  </HediffDef>
</Defs>
